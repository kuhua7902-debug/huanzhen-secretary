# ============================================================
#  幻帧 Agent 环境变量模板
#  用法：复制本文件为 .env，填入真实值。.env 已被 gitignore，不会入库。
#
#     copy .env.example .env      (Windows)
#
#  ⚠️ 命名说明：环境变量统一使用 HUANZHEN_* 前缀。
#     历史前缀 KEJI_* 仍可识别（供旧部署平滑迁移），但新部署请使用 HUANZHEN_*。
# ============================================================

# ------------------------------------------------------------
# 必填：管理员账号
# ------------------------------------------------------------
# 首次启动且数据库中没有任何用户时，用它创建第一个管理员账号。
# 之后改密码请走管理页或 scripts/reset_password.py。
HUANZHEN_ADMIN_PASSWORD=请改成你自己的强密码

# ------------------------------------------------------------
# 必填：至少一个对话模型密钥
# 改哪个由 config.yaml 的 models.default 决定（默认 deepseek）
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# ------------------------------------------------------------
# 建议填写：安全
# ------------------------------------------------------------
# JWT 签名密钥。留空会在 data/security/jwt_secret 自动生成一个随机值
# —— 注意该文件丢失会导致所有已登录用户立即掉线，生产环境建议显式配置。
HUANZHEN_JWT_SECRET=
# 服务级 API Key（供脚本/服务调用，可选）
HUANZHEN_API_KEY=

# ------------------------------------------------------------
# 可选：知识库向量嵌入需要本地 Ollama
# ------------------------------------------------------------
# 未安装 Ollama 时知识库索引会退化为零向量，检索无结果。
# 安装后执行：ollama pull nomic-embed-text

# ------------------------------------------------------------
# 可选：联网搜索
# ------------------------------------------------------------
TAVILY_API_KEY=

# ------------------------------------------------------------
# 可选：语音助手（启动幻帧语音助手.bat）
# ------------------------------------------------------------
# 语音识别 STT（Groq Whisper，免费额度足够个人使用）
GROQ_API_KEY=
# Picovoice 唤醒词引擎（仅 --backend porcupine 时需要）
PICOVOICE_ACCESS_KEY=

# ------------------------------------------------------------
# 可选：MCP 扩展工具
# ------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=
OPENWEATHER_API_KEY=

# ------------------------------------------------------------
# 可选：飞书渠道（需同时在 config.yaml 里把 channels.feishu.enabled 设为 true）
# ------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
