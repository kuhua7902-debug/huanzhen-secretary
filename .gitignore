*.local.bat
*密钥*.txt

# Runtime data
data/
sessions/
logs/
.memdb/
.deepseek/

# 截图与演示产物（gui_tools.screenshot_screen 默认落点，会持续增长；实测已堆积 160MB+）
screenshots/
huanzhen-screenshots/
# 工作流删除时产生的备份
data/workflows/.trash/
# 自检 / 视觉调试输出
data/image/
data/tmp/

# Offline deploy (venv copy only; wheels are in Git LFS under offline_packages/)
portable_bundle/

# Build artifacts
dist/
build/
*.spec
# 例外：新版前端（Vite）构建产物需随仓库分发，离线部署时无需安装 Node
!web/dist/
!web/dist/**

# IDE / tooling artifacts
.playwright-cli/

